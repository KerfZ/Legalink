# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Service-role key (server-only) — used by /api/payments/webhook to flip
# transaction status past RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=your-service-role-key

# Payment provider: "mock" (default, no external calls) or a real gateway
# name once implemented (see lib/payments.ts).
NEXT_PUBLIC_PAYMENT_PROVIDER=mock
